{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/slide-generator-ai/schemas/slide-document.schema.json",
  "title": "Slide Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "meta", "context", "assumptions", "narrative", "slides"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "language"],
      "anyOf": [
        { "required": ["theme"] },
        { "required": ["designPackage"] }
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string" },
        "language": { "type": "string" },
        "theme": { "type": "string" },
        "designPackage": { "type": "string", "minLength": 1 },
        "pageRatio": { "type": "string", "enum": ["16:9", "4:3"] }
      }
    },
    "context": {
      "$ref": "./presentation-context.schema.json"
    },
    "assumptions": {
      "$ref": "./assumptions.schema.json"
    },
    "narrative": {
      "$ref": "./narrative-plan.schema.json"
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slide"
      }
    }
  },
  "$defs": {
    "componentNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "variant": { "type": "string" },
        "props": { "type": "object" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/componentNode" }
        }
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "purpose", "message", "pageTemplate", "regions"],
      "properties": {
        "id": { "type": "string", "pattern": "^slide-[0-9]{2,}$" },
        "role": { "type": "string" },
        "purpose": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "pageTemplate": { "type": "string", "minLength": 1 },
        "design": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "variant": { "type": "string" },
            "density": { "type": "string", "enum": ["low", "medium", "high"] }
          }
        },
        "regions": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/componentNode" }
          }
        },
        "speakerNotes": { "type": "string" },
        "sources": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
